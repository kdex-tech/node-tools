#!/usr/bin/env node

import { integritySummary, ledgerStatusLine, resolveLedgerDir, verifyIntegrity } from './verify_integrity.js';

// Exit non-zero on a CONFIRMED mismatch only. Packages that could not be
// verified are reported and tolerated -- see verify_integrity.js for why
// "could not check" must not fail the build.
//
// Set VERIFY_INTEGRITY=0 to skip entirely (escape hatch for a registry that
// cannot serve dist metadata). See kdex-tech/host-manager#161.
async function run() {
    if (process.env.VERIFY_INTEGRITY === '0') {
        console.log('--- Skipping integrity verification (VERIFY_INTEGRITY=0) ---');
        return;
    }

    // With a cache claim attached the ledger removes the tarball round trip for
    // any (package, version) already verified by an earlier Job. Without one it
    // is null and every Job pays the full cold path.
    //
    // Logged UNCONDITIONALLY, including the null case: that state is the
    // correct degradation but it used to be a silent one, and it cost a prod
    // Job 88% of its wall time across 33 generations (node-tools#8).
    const ledgerDir = resolveLedgerDir();
    console.log(`--- Verification ${ledgerStatusLine(ledgerDir)} ---`);

    const { checked, skipped, failures, unverified } = await verifyIntegrity({
        workdir: process.env.WORKDIR || process.cwd(),
        ledgerDir,
    });

    const { summary, warnings } = integritySummary({
        checked, skipped, unverified, failures, ledgerDir,
    });
    console.log(summary);
    for (const warning of warnings) {
        console.warn(`  ! ${warning}`);
    }

    // Opt-in only. "could not check" still must not fail a build by default --
    // a registry blip would be worse than the bug this guards against -- but a
    // pipeline that wants the guard to be load-bearing needs a way to say so
    // (node-tools#9).
    if (process.env.VERIFY_INTEGRITY_STRICT === '1' && unverified.length > 0) {
        console.error('');
        console.error('Refusing to aggregate: VERIFY_INTEGRITY_STRICT=1 and some packages could not be verified:');
        for (const u of unverified) {
            console.error(`  ? ${u.name}@${u.version}: ${u.reason}`);
        }
        process.exit(1);
    }

    if (failures.length > 0) {
        console.error('');
        console.error('Installed packages do NOT match the registry:');
        for (const f of failures) {
            console.error(`  ✗ ${f.name}@${f.version}: ${f.reason}`);
        }
        console.error('');
        console.error(
            'Refusing to aggregate. This is the propagation-window failure from ' +
            'kdex-tech/host-manager#161: the install captured content that is not ' +
            'what the registry publishes for the pinned version. Re-running once ' +
            'the registry is consistent produces a correct image.'
        );
        process.exit(1);
    }
}

run().catch((err) => {
    console.error('Integrity verification runner failed:', err);
    process.exit(1);
});
